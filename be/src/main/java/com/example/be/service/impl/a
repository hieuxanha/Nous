package com.example.be.service.impl;

import com.example.be.dto.CheckoutRequest;
import com.example.be.entity.*;
import com.example.be.repository.*;
import com.example.be.service.OrderService;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import com.example.be.entity.Order.OrderStatus; // Import Enum
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PutMapping;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;

@Service
@RequiredArgsConstructor
public class OrderServiceImpl implements OrderService {

    private final UserRepository userRepository;
    private final CartRepository cartRepository;
    private final OrderRepository orderRepository;
    private final ProductRepository productRepository;
    private final OrderItemRepository orderItemRepository;
    private final OrderService orderService;

    @Override
    public Order placeOrder(Long userId, CheckoutRequest request) {

//         lấy user

        User user = userRepository.findById(userId)
                .orElseThrow(()->new RuntimeException("User not found"));

//      lấy giỏ hnagf

        Cart cart = cartRepository.findByUserId(userId)
                .orElseThrow(()->new RuntimeException("Cart not found"));

        if(cart.getItems().isEmpty()){
            throw new RuntimeException("Giỏ hnagf không thể để trống");
        }

//         khởi tạo
        // 3. Khởi tạo Order (Trạng thái PENDING)
        Order order = Order.builder()
                .user(user)
                .fullName(request.getFullName())
                .email(request.getEmail())
                .phone(request.getPhone())
                .address(request.getAddress())
                .city(request.getCity())
                .district(request.getDistrict())
                .ward(request.getWard())
                .paymentMethod(request.getPaymentMethod())
                .status(OrderStatus.PENDING)
                .orderDate(LocalDateTime.now())
                .totalPrice(0.0)
                .build();

//        lưu oeder trước id
        Order savedOrder = orderRepository.save(order);

        // xuywr lý  từng cart item  -> Ỏrder
        double totalAmount = 0;
        List<OrderItem> orderItems = new ArrayList<>();

        for(CartItem cartItem : cart.getItems()){
            Product product = cartItem.getProduct();

            if(product.getQuantity() < cartItem.getQuantity()){
                throw new RuntimeException("Sản phẩm" +product.getName()+"Không đủ");
            }

            // trừ khooo
//            bỏ trừ khao  chỉ tạo dơn

//            product.setQuantity(product.getQuantity() - cartItem.getQuantity());
//            productRepository.save(product);

// Tạo OrderItem
            OrderItem orderItem = OrderItem.builder()
                    .order(savedOrder)
                    .product(product)
                    .productName(product.getName())
                    .size(cartItem.getSize())
                    .quantity(cartItem.getQuantity())
                    .price(product.getPrice())
                    // Lưu giá tại thời điểm mua
                    .productImage(product.getImage()) // Lưu link ảnh sản phẩm vào OrderItem
                    .build();

            orderItems.add(orderItem);
            totalAmount += (product.getPrice() * cartItem.getQuantity());
        }

//        lưu danh sáchh Odderitemms
         orderItemRepository.saveAll(orderItems);


        savedOrder.setTotalPrice(totalAmount);
        savedOrder.setOrderItems(orderItems);
//         Cập nhật lại danh sach
        orderRepository.save(savedOrder);

//        Xóa sách giở hnagf
        cart.getItems().clear();
        cartRepository.save(cart);






        return savedOrder;
    }

    @Override
    @Transactional

    public Order updateOrderStatus(Long orderId, String statusStr) {
        Order order = orderRepository.findById(orderId)
                .orElseThrow(()->new RuntimeException("Không timf thấy dơn hàng"));

        OrderStatus newStatus;
        try{
            newStatus = OrderStatus.valueOf(statusStr);
        } catch (IllegalArgumentException e) {
            throw new RuntimeException("Trạng thất không hợp lệ ");
        }

        // chuyển snag CONFIRMED mới trừ kho

        if(newStatus == OrderStatus.COMPLETED && order.getStatus() == OrderStatus.COMPLETED){

//             duyệt qua các sản phẩm trong dơn trưừ khoo

            for(OrderItem item :order.getOrderItems() ){
                Product product = item.getProduct();

                if(product.getQuantity() < item.getQuantity()){
                    throw new RuntimeException("Sản phẩm "+product.getName()+" hiện không còn đủ hàng để xác nhận đơn này!");
                }

//               thục hiện trừ kho
                product.setQuantity(product.getQuantity() - item.getQuantity());
                productRepository.save(product);
            }
        }
        // --- LOGIC HOÀN KHO (Nếu Hủy đơn đã Confirm/Shipping) ---
        // Nếu đơn hàng đang ở trạng thái đã trừ kho (Confirmed/Shipping) mà bị Hủy -> Cộng lại kho
        if (newStatus == OrderStatus.CANCELLED &&
                (order.getStatus() == OrderStatus.CONFIRMED || order.getStatus() == OrderStatus.SHIPPING)) {
            for (OrderItem item : order.getOrderItems()) {
                Product product = item.getProduct();
                product.setQuantity(product.getQuantity() + item.getQuantity());
                productRepository.save(product);
            }
        }

        order.setStatus(newStatus);
        return orderRepository.save(order);

    }




}

